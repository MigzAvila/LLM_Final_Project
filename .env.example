# =============================================================================
# AgentSociety + CrewAI — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env` or real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — OpenAI-compatible API (NVIDIA NIM, Minimax, OpenAI, etc.)
# Used by CrewAI / LiteLLM via OPENAI_API_KEY + base URL.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-compatible-api-key-here
NVIDIA_MODEL_NAME=your-provider/model-id
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# Many stacks read OPENAI_BASE_URL; kept in sync with OPENAI_API_BASE for LiteLLM/CrewAI.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional convenience aliases (model IDs are also set per agent in config/agents.yaml).
OPENAI_MODEL_NAME=your-provider/model-id
NVIDIA_MODEL_NAME=your-provider/model-id

# -----------------------------------------------------------------------------
# CrewAI — serving flow (src/flows/serving_flow.py)
# Values: sequential | collaborative | hierarchical
# -----------------------------------------------------------------------------
CREWAI_PROCESS_MODE=sequential

# -----------------------------------------------------------------------------
# CrewAI — optional RAG / knowledge (src/crews/simulation_crew.py)
# Disabled by default; sequential pipeline already injects Yelp rows into prompts.
# -----------------------------------------------------------------------------
CREWAI_ENABLE_KNOWLEDGE=false
# Primary path; CREWAI_KNOWLEDGE_JSON is used only if CREWAI_KNOWLEDGE_FILE is empty.
CREWAI_KNOWLEDGE_FILE=yelp_dataset/item.json
CREWAI_KNOWLEDGE_JSON=true
# CREWAI_USE_PREBUILT_INDEX — only applies when CREWAI_ENABLE_KNOWLEDGE=true.
# Accepted truthy values: true | 1 | yes | on (anything else = false).
# true  → On startup, if Chroma already has collection "knowledge_crew" with
#         documents, skip re-reading the JSON file and skip re-embedding (fast).
# false → Always run add(): ingest knowledge_file and build/update embeddings
#         (slower; use after changing the file or embedder).
CREWAI_USE_PREBUILT_INDEX=true
# Optional persistence root for CrewAI/Chroma (empty = CrewAI default under project).
CREWAI_STORAGE_DIR=AgentSocietyChallenge_w_CrewAI

# -----------------------------------------------------------------------------
# CrewAI — knowledge indexing (scripts/index_knowledge.py)
# Defaults match script: sentence-transformer if model left empty.
# -----------------------------------------------------------------------------
CREWAI_EMBEDDER_PROVIDER=sentence-transformer
CREWAI_EMBEDDER_MODEL=

# -----------------------------------------------------------------------------
# Simulator — run_simulator_test.py (websocietysimulator Simulator.run_simulation)
# SIMULATOR_NUM_TASKS: integer, or "all" / "full" for every task in the task dir.
# -----------------------------------------------------------------------------
SIMULATOR_NUM_TASKS=5
SIMULATOR_THREADING=false
SIMULATOR_MAX_WORKERS=1

# -----------------------------------------------------------------------------
# Optional — only if you wire tools/agents that use these providers
# (not required by websocietysimulator core or the default CrewAI path)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
SERPER_API_KEY=
COHERE_API_KEY=
# Not read by this repo; optional mirror for other tools.
OPENAI_API_KEY_FALLBACK=
